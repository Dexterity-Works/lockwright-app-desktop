{
  "appId": "works.dexterity.lockwright",
  "productName": "Lockwright",
  "icon": "assets/win32/icon.png",
  "asar": false,
  "electronDownload": {
    "cache": ".cache/electron"
  },
  "directories": {
    "output": "out"
  },
  "files": [
    "electron/**/*",
    "dist/**/*",
    "!dist/**/*.map",
    "index.html",
    "packages/**/*",
    "assets/**/*",
    "src/utils/**/*",
    "!**/node_modules/react-native/**/*",
    "!**/node_modules/@react-native/**/*"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets"
    },
    {
      "from": "resources/bin",
      "to": "bin"
    }
  ],
  "afterPack": "scripts/afterPack.cjs",
  "extraMetadata": {
    "upgrade": null
  },
  "win": {
    "icon": "assets/win32/icon.png",
    "target": ["nsis"],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "signAndEditExecutable": true,
    "signExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lockwright",
    "uninstallDisplayName": "Lockwright",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "differentialPackage": false
  }
}
