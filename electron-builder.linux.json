{
  "appId": "works.dexterity.lockwright",
  "icon": "assets/linux/icon.png",
  "asar": false,
  "directories": {
    "output": "out"
  },
  "files": [
    "electron/**/*",
    "dist/**/*",
    "!dist/**/*.map",
    "index.html",
    "packages/**/*",
    "assets/**/*",
    "src/utils/**/*",
    "!**/node_modules/react-native/**/*",
    "!**/node_modules/@react-native/**/*"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets"
    },
    {
      "from": "resources/bin",
      "to": "bin"
    }
  ],
  "linux": {
    "icon": "assets/linux/icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Lockwright",
        "StartupWMClass": "Lockwright"
      }
    }
  },
  "toolsets": {
    "appimage": "1.0.2"
  },
  "afterPack": "scripts/afterPack.cjs",
  "extraMetadata": {
    "upgrade": null
  }
}
