{
  "name": "lockwright-app-desktop",
  "productName": "Lockwright",
  "version": "0.0.30",
  "description": "Lockwright password manager",
  "author": "Lockwright",
  "main": "electron/main.cjs",
  "upgrade": "pear://dbkezmhetxwo95ab1kcojfraw1eryzf7kex5cahykf6b9c3amd6o",
  "legacyChannelLink": "pear://tywsat7gz8m65ejx4zjn3773pbdc4j8m66tukis8dgzekraymtzo",
  "build": {
    "appId": "works.dexterity.lockwright",
    "icon": "assets/darwin/icon.png",
    "asar": false,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "!dist/**/*.map",
      "index.html",
      "packages/**/*",
      "assets/**/*",
      "src/utils/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/darwin/icon.png",
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "afterSign": "scripts/notarize.cjs",
    "afterPack": "scripts/afterPack.cjs",
    "dmg": {},
    "linux": {
      "icon": "assets/linux/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Lockwright",
          "StartupWMClass": "Lockwright"
        }
      }
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dexterity-Works",
        "repo": "lockwright-app-desktop"
      }
    ]
  },
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "jest",
    "build:app": "lingui extract && lingui compile && tsc",
    "lint:fix": "eslint --fix ./src",
    "lint": "eslint ./src",
    "build:worklet": "node scripts/build.worklet.mjs",
    "build": "node scripts/write-git-sha.cjs && node scripts/build.worklet.mjs && pnpm run build:app && node scripts/bundle-renderer.mjs && node scripts/bundle-bridge.mjs",
    "build:prod": "cross-env NODE_ENV=production pnpm run build",
    "bundle:renderer": "node scripts/bundle-renderer.mjs",
    "bundle:bridge": "node scripts/bundle-bridge.mjs",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "prepare": "husky",
    "postinstall": "install-electron && node scripts/patch-electron-dock-name.mjs",
    "electron": "electron .",
    "dev": "concurrently -n \"TypeScript,Bundle,Bridge,Electron\" -c \"blue,cyan,magenta,green\" \"node node_modules/typescript/bin/tsc --watch\" \"node scripts/bundle-renderer.mjs --watch\" \"node scripts/bundle-bridge.mjs --watch\" \"wait-on dist/renderer.bundle.js && electron .\"",
    "dev:reset": "PEARPASS_DEV_RESET=1 pnpm run dev",
    "dist:prepare:dev": "npm install && pnpm run build:prod && npm prune --omit=dev && npm install electron --no-save && install-electron",
    "dist:mac:arm64": "pnpm run build:prod && pnpm exec electron-builder --mac --arm64 -c electron-builder.mac.json --publish never",
    "dist:mac:x64": "pnpm run build:prod && pnpm exec electron-builder --mac --x64 -c electron-builder.mac.json --publish never",
    "dist:mac:arm64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:arm64",
    "dist:mac:x64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:x64",
    "dist:win:nsis:x64": "pnpm run build:prod && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false PEARPASS_DISABLE_UPGRADE=1 ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder node scripts/run-electron-builder.cjs --win --x64 -c electron-builder.win.json -c.electronDist=node_modules/electron/dist --publish never",
    "dist:win:nsis:arm64": "pnpm run build:prod && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false PEARPASS_DISABLE_UPGRADE=1 ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder node scripts/run-electron-builder.cjs --win --arm64 -c electron-builder.win.json --publish never",
    "dist:linux:x64": "pnpm run build:prod && cross-env PEARPASS_DISABLE_UPGRADE=1 node scripts/run-electron-builder.cjs --linux --x64 -c electron-builder.linux.json --publish never",
    "dist:linux:arm64": "pnpm run build:prod && cross-env PEARPASS_DISABLE_UPGRADE=1 node scripts/run-electron-builder.cjs --linux --arm64 -c electron-builder.linux.json --publish never",
    "dist:snap:x64": "pnpm run build:prod && pnpm exec electron-builder --linux snap --x64 --publish never",
    "dist:snap:arm64": "pnpm run build:prod && pnpm exec electron-builder --linux snap --arm64 --publish never",
    "dist:snap:x64:dev": "pnpm run dist:prepare:dev && pnpm run dist:snap:x64 && npm install",
    "dist:snap:arm64:dev": "pnpm run dist:prepare:dev && pnpm run dist:snap:arm64 && npm install",
    "preinstall": "node scripts/ensure-pnpm.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "^7.28.5",
    "@electron/notarize": "^2.2.1",
    "@lingui/cli": "5.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "^25.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "babel-jest": "29.7.0",
    "buffer": "^6.0.3",
    "concurrently": "9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.24.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.0",
    "postcss": "8.4.49",
    "prettier": "3.8.3",
    "fast-glob": "3.3.3",
    "@jest/globals": "29.7.0"
  },
  "dependencies": {
    "@lingui/core": "5.1.2",
    "@lingui/format-json": "5.1.2",
    "@lingui/react": "5.1.2",
    "lockwright-lib-ui-react-hooks": "git+https://github.com/Dexterity-Works/lockwright-lib-ui-react-hooks.git#8552ca7b1bd06a077c3f97b78634cb1014839ba3",
    "lockwright-utils-validator": "git+https://github.com/Dexterity-Works/lockwright-utils-validator.git#95488f2c385ec7b09619c587417baf454134dd7b",
    "lockwright-lib-constants": "git+https://github.com/Dexterity-Works/lockwright-lib-constants.git#f6142c9554e9f972519dd8115b2b73f02b73d5fb",
    "lockwright-lib-data-export": "git+https://github.com/Dexterity-Works/lockwright-lib-data-export.git#9fe6af5fcf740fe8a52eb05a09bb188d6dcd7de1",
    "lockwright-lib-data-import": "git+https://github.com/Dexterity-Works/lockwright-lib-data-import.git#6a872f3c2d618a3e2b16e425c2b6c6e2fed693dc",
    "lockwright-lib-ui-react-native-components": "git+https://github.com/Dexterity-Works/lockwright-lib-ui-react-native-components.git#5a4ed69feda9b76c0de6f40cb12df72569beb9b4",
    "lockwright-lib-vault": "file:../pearpass-lib-vault",
    "lockwright-lib-vault-core": "file:../pearpass-lib-vault-core",
    "lockwright-utils-password-check": "git+https://github.com/Dexterity-Works/lockwright-utils-password-check.git#dc56473c03d574ddb80a98f2560cea69d01b1cca",
    "lockwright-utils-password-generator": "git+https://github.com/Dexterity-Works/lockwright-utils-password-generator.git#e3f4b7689ff3eef247a64bff0790357d4bee793a",
    "htm": "3.1.1",
    "jszip": "3.10.1",
    "pear-ipc": "6.4.0",
    "pear-runtime": "^1.1.1",
    "pear-runtime-legacy-storage": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "styled-components": "6.1.19",
    "bare-sidecar": "0.5.4",
    "sodium-native": "5.1.0",
    "@lingui/message-utils": "5.9.5",
    "compact-encoding": "2.18.0",
    "lockwright-utils-generate-unique-id": "git+https://github.com/Dexterity-Works/lockwright-utils-generate-unique-id.git#b1cec22b12b85bb1186aafa05223be64b7aea2cc",
    "lockwright-utils-qr": "git+https://github.com/Dexterity-Works/lockwright-utils-qr.git#c6ca850b1dec0dd7e8d12d3c380964ed607114cc"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.24.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.10.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "error"
    }
  }
}
