{
  "name": "lockwright-app-desktop",
  "productName": "Lockwright",
  "version": "0.0.22",
  "description": "Lockwright password manager",
  "author": "Lockwright",
  "main": "electron/main.cjs",
  "upgrade": "pear://dbkezmhetxwo95ab1kcojfraw1eryzf7kex5cahykf6b9c3amd6o",
  "legacyChannelLink": "pear://tywsat7gz8m65ejx4zjn3773pbdc4j8m66tukis8dgzekraymtzo",
  "build": {
    "appId": "works.dexterity.lockwright",
    "icon": "assets/darwin/icon.png",
    "asar": false,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "index.html",
      "index.js",
      "packages/**/*",
      "assets/**/*",
      "src/utils/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/darwin/icon.png",
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "afterSign": "scripts/notarize.cjs",
    "afterPack": "scripts/afterPack.cjs",
    "dmg": {},
    "linux": {
      "icon": "assets/linux/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Lockwright",
          "StartupWMClass": "Lockwright"
        }
      }
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Thaoh",
        "repo": "lockwright-app-desktop"
      }
    ]
  },
  "pear": {
    "name": "lockwright-app-desktop",
    "routes": ".",
    "unrouted": [
      "/packages/pearpass-lib-vault-core/src/worklet/app.js"
    ],
    "gui": {
      "backgroundColor": "#1F2430",
      "height": "1024",
      "width": "1440",
      "minWidth": "816"
    },
    "links": [],
    "stage": {
      "entrypoints": [],
      "prefetch": [
        "assets",
        "resources"
      ],
      "ignore": [
        ".github",
        "appling",
        ".git",
        ".gitignore",
        ".husky",
        "e2e",
        "scripts",
        "src",
        "tsconfig.json",
        "eslint.config.js",
        "jest.config.js",
        "flatpak"
      ]
    }
  },
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "jest",
    "build:app": "lingui extract && lingui compile && tsc",
    "lint:fix": "eslint --fix ./src",
    "lint": "eslint ./src",
    "build:worklet": "node scripts/build.worklet.mjs",
    "build": "node scripts/write-git-sha.cjs && node scripts/build.worklet.mjs && pnpm run build:app && node scripts/bundle-renderer.mjs && node scripts/bundle-bridge.mjs",
    "build:prod": "cross-env NODE_ENV=production pnpm run build",
    "bundle:renderer": "node scripts/bundle-renderer.mjs",
    "bundle:bridge": "node scripts/bundle-bridge.mjs",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "prepare": "husky",
    "postinstall": "node scripts/patch-electron-dock-name.mjs",
    "watch:packages": "nodemon --watch packages --ext js,json --exec \"echo 'Packages changed'\"",
    "electron": "electron .",
    "dev": "concurrently -n \"TypeScript,Bundle,Bridge,Electron\" -c \"blue,cyan,magenta,green\" \"node node_modules/typescript/bin/tsc --watch\" \"node scripts/bundle-renderer.mjs --watch\" \"node scripts/bundle-bridge.mjs --watch\" \"wait-on dist/renderer.bundle.js && electron .\"",
    "dev:reset": "PEARPASS_DEV_RESET=1 pnpm run dev",
    "dist:prepare:dev": "npm install && pnpm run build:prod && npm prune --omit=dev && npm install electron --no-save",
    "dist:mac:arm64": "pnpm run build:prod && pnpm exec electron-builder --mac --arm64 -c electron-builder.mac.json --publish never",
    "dist:mac:x64": "pnpm run build:prod && pnpm exec electron-builder --mac --x64 -c electron-builder.mac.json --publish never",
    "dist:mac:arm64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:arm64",
    "dist:mac:x64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:x64",
    "dist:win:x64": "pnpm run build:prod && electron-forge make --platform=win32 --arch=x64",
    "dist:win:arm64": "pnpm run build:prod && electron-forge make --platform=win32 --arch=arm64",
    "dist:win:x64:dev": "pnpm run build:prod && cross-env SKIP_WIN_SIGN=true electron-forge make --platform=win32 --arch=x64",
    "dist:win:arm64:dev": "pnpm run build:prod && cross-env SKIP_WIN_SIGN=true electron-forge make --platform=win32 --arch=arm64",
    "dist:win:nsis:x64": "pnpm run build:prod && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false PEARPASS_DISABLE_UPGRADE=1 ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder node scripts/run-electron-builder.cjs --win --x64 -c electron-builder.win.json -c.electronDist=node_modules/electron/dist --publish never",
    "dist:win:nsis:arm64": "pnpm run build:prod && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false PEARPASS_DISABLE_UPGRADE=1 ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder node scripts/run-electron-builder.cjs --win --arm64 -c electron-builder.win.json --publish never",
    "dist:linux:x64": "pnpm run build:prod && cross-env PEARPASS_DISABLE_UPGRADE=1 node scripts/run-electron-builder.cjs --linux --x64 -c electron-builder.linux.json --publish never",
    "dist:linux:arm64": "pnpm run build:prod && cross-env PEARPASS_DISABLE_UPGRADE=1 node scripts/run-electron-builder.cjs --linux --arm64 -c electron-builder.linux.json --publish never",
    "make": "pnpm run build:prod && electron-forge make --platform=win32 --arch=x64 && electron-forge make --platform=win32 --arch=arm64",
    "dist:snap:x64": "pnpm run build:prod && pnpm exec electron-builder --linux snap --x64 --publish never",
    "dist:snap:arm64": "pnpm run build:prod && pnpm exec electron-builder --linux snap --arm64 --publish never",
    "dist:snap:x64:dev": "pnpm run dist:prepare:dev && pnpm run dist:snap:x64 && npm install",
    "dist:snap:arm64:dev": "pnpm run dist:prepare:dev && pnpm run dist:snap:arm64 && npm install",
    "pear:build:darwin:arm64": "npx pear-build --package=./package.json --darwin-arm64-app ./out/mac-arm64/Lockwright.app --target ../lockwright-app-desktop-$npm_package_version",
    "pear:build:darwin:x64": "npx pear-build --package=./package.json --darwin-x64-app ./out/mac/Lockwright.app --target ../lockwright-app-desktop-$npm_package_version",
    "pear:build:linux:x64": "npx pear-build --package=./package.json --linux-x64-app ./out/Lockwright.AppImage --target ../lockwright-app-desktop-$npm_package_version",
    "pear:build:linux:arm64": "npx pear-build --package=./package.json --linux-arm64-app ./out/Lockwright.AppImage --target ../lockwright-app-desktop-$npm_package_version",
    "pear:build:win:x64": "npx pear-build --package=./package.json --win32-x64-app ./out/Lockwright/Lockwright.msix --target ../lockwright-app-desktop-%npm_package_version%",
    "pear:build:win:arm64": "npx pear-build --package=./package.json --win32-arm64-app ./out/Lockwright/Lockwright.msix --target ../lockwright-app-desktop-%npm_package_version%",
    "knip": "knip",
    "preinstall": "node scripts/ensure-pnpm.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "^7.28.5",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-msix": "^7.6.0",
    "@electron/notarize": "^2.2.1",
    "@lingui/cli": "5.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@tetherto/tether-dev-docs": "github:tetherto/tether-dev-docs",
    "@types/node": "^25.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vercel/ncc": "0.38.3",
    "babel-jest": "29.7.0",
    "bare-pack": "1.4.8",
    "cmake-pear": "2.0.0",
    "concurrently": "9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.24.2",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "knip": "^6.14.1",
    "nodemon": "^3.0.0",
    "patch-package": "^8.0.1",
    "pear-build": "^1.1.0",
    "pear-interface": "1.0.0",
    "pear-runtime-updater": "^3.0.10",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.0",
    "which-runtime": "^1.3.2"
  },
  "dependencies": {
    "@lingui/core": "5.1.2",
    "@lingui/format-json": "5.1.2",
    "@lingui/macro": "5.1.2",
    "@lingui/react": "5.1.2",
    "@tetherto/pear-apps-lib-ui-react-hooks": "git+https://github.com/tetherto/pear-apps-lib-ui-react-hooks.git",
    "@tetherto/pear-apps-utils-avatar-initials": "git+https://github.com/tetherto/pear-apps-utils-avatar-initials.git",
    "@tetherto/pear-apps-utils-date": "git+https://github.com/tetherto/pear-apps-utils-date.git",
    "@tetherto/pear-apps-utils-generate-unique-id": "git+https://github.com/tetherto/pear-apps-utils-generate-unique-id.git",
    "@tetherto/pear-apps-utils-qr": "git+https://github.com/tetherto/pear-apps-utils-qr.git",
    "@tetherto/pear-apps-utils-validator": "git+https://github.com/tetherto/pear-apps-utils-validator.git",
    "@tetherto/pearpass-lib-constants": "git+https://github.com/Thaoh/lockwright-lib-constants.git#0cf657575130f2168f883579c17daf344e4aaefd",
    "@tetherto/pearpass-lib-data-export": "git+https://github.com/tetherto/pearpass-lib-data-export.git",
    "@tetherto/pearpass-lib-data-import": "git+https://github.com/tetherto/pearpass-lib-data-import.git",
    "@tetherto/pearpass-lib-native-messaging-bridge": "git+https://github.com/tetherto/pearpass-lib-native-messaging-bridge.git",
    "@tetherto/pearpass-lib-ui-kit": "git+https://github.com/Thaoh/lockwright-lib-ui-react-native-components.git#design-system-v2",
    "@tetherto/pearpass-lib-vault": "file:../pearpass-lib-vault",
    "@tetherto/pearpass-lib-vault-core": "file:../pearpass-lib-vault-core",
    "@tetherto/pearpass-utils-password-check": "git+https://github.com/tetherto/pearpass-utils-password-check.git",
    "@tetherto/pearpass-utils-password-generator": "git+https://github.com/tetherto/pearpass-utils-password-generator.git",
    "autopass": "~3.3.0",
    "bare-os": "3.6.2",
    "bare-subprocess": "5.2.1",
    "buffer": "6.0.3",
    "compact-encoding": "2.18.0",
    "dotenv": "17.2.1",
    "electron-updater": "^6.8.3",
    "htm": "3.1.1",
    "hyperblobs": "^2.11.1",
    "hyperdht": "^6.29.6",
    "hyperdrive": "^13.3.2",
    "jsqr": "^1.4.0",
    "jszip": "3.10.1",
    "mirror-drive": "^1.14.1",
    "pear-aliases": "1.0.6",
    "pear-bridge": "1.2.4",
    "pear-electron": "1.7.25-rc.0",
    "pear-ipc": "6.4.0",
    "pear-run": "1.0.5",
    "pear-runtime": "^1.1.1",
    "pear-runtime-legacy-storage": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "styled-components": "6.1.19"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.24.2"
  },
  "overrides": {
    "@tetherto/pearpass-lib-constants": "git+https://github.com/Thaoh/lockwright-lib-constants.git#0cf657575130f2168f883579c17daf344e4aaefd",
    "@xmldom/xmldom": "^0.8.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "electron-windows-msix": "git+https://github.com/chetasr/electron-windows-msix.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.10.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "error"
    }
  }
}
